<Window x:Class="DepotDownloaderGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DepotDownloaderGUI"
        xmlns:vm="clr-namespace:DepotDownloaderGUI.ViewModels"
        xmlns:models="clr-namespace:DepotDownloaderGUI.Models"
        mc:Ignorable="d"
        Title="DepotDownloader Pro" Height="700" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Status to Icon Converter -->
        <local:StatusToIconConverter x:Key="StatusToIconConverter"/>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <local:SpeedToStringConverter x:Key="SpeedToStringConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Job List -->
        <Grid Grid.Column="0" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                   Background="{StaticResource SecondaryBackgroundBrush}"
                   Padding="8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="+" Width="32" Height="32" Padding="0"
                           Margin="2" Command="{Binding AddJobCommand}" ToolTip="Add Job"/>
                    <Button Content="💾" Width="32" Height="32" Padding="0"
                           Margin="2" Command="{Binding SaveConfigurationCommand}" ToolTip="Save Configuration"/>
                    <Button Content="📂" Width="32" Height="32" Padding="0"
                           Margin="2" Command="{Binding LoadConfigurationCommand}" ToolTip="Load Configuration"/>
                    <Button Content="⚙" Width="32" Height="32" Padding="0"
                           Margin="2" ToolTip="Settings"/>
                    <Button Content="ℹ" Width="32" Height="32" Padding="0"
                           Margin="2" ToolTip="Info"/>
                </StackPanel>
            </Border>

            <!-- Job List -->
            <ListBox Grid.Row="1"
                    ItemsSource="{Binding DownloadJobs}"
                    SelectedItem="{Binding SelectedJob}"
                    BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>

                            <!-- Job Name and Icon -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                          FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>

                            <!-- Paths -->
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SourcePath}"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TargetPath}"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Size Info -->
                            <TextBlock Grid.Row="2" Margin="0,2,0,4"
                                      FontSize="11"
                                      Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding TotalFiles, Mode=OneWay}"/>
                                <Run Text=""/>
                                <Run Text="{Binding TotalSize, Converter={StaticResource BytesToStringConverter}, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Progress Bar -->
                            <ProgressBar Grid.Row="3"
                                        Value="{Binding Progress}"
                                        Maximum="100"
                                        Height="6"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right Panel - Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Current Job Header -->
            <Border Grid.Row="0"
                   Background="{StaticResource SecondaryBackgroundBrush}"
                   Padding="16,12"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Copying"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding SelectedJob.SourcePath}"
                                  FontSize="12"
                                  Margin="0,4,0,0"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding SelectedJob.ProcessedFiles, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding SelectedJob.TotalFiles, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.DownloadedSize, Converter={StaticResource BytesToStringConverter}, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.TotalSize, Converter={StaticResource BytesToStringConverter}, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.Progress, StringFormat={}{0:F1} %, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Target Info -->
            <Border Grid.Row="1"
                   Background="{StaticResource BackgroundBrush}"
                   Padding="16,12"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Target"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedJob.TargetPath}"
                                  FontSize="12"
                                  Margin="0,2,0,0"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Foreground="{StaticResource TextBrush}">
                        <Run Text="{Binding SelectedJob.Speed, Converter={StaticResource SpeedToStringConverter}, Mode=OneWay}"/>
                        <Run Text=" - 3 s"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.DownloadedSize, Converter={StaticResource BytesToStringConverter}, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.TotalSize, Converter={StaticResource BytesToStringConverter}, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding SelectedJob.Progress, StringFormat={}{0:F1} %, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="2"
                        Height="8"
                        Value="{Binding SelectedJob.Progress}"
                        Maximum="100"
                        BorderThickness="0"/>

            <!-- Content Area with Tabs -->
            <Grid Grid.Row="3">
                <TabControl>
                    <!-- File List Tab -->
                    <TabItem Header="File List">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Grid.Row="0"
                                   Background="{StaticResource SecondaryBackgroundBrush}"
                                   Padding="8"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Menu" Width="80" Margin="0,0,8,0"/>
                                    <CheckBox Content="Auto-scroll"
                                             IsChecked="{Binding AutoScroll}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0"/>
                                    <TextBlock Text="All items"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- File List DataGrid -->
                            <DataGrid x:Name="FilesDataGrid"
                                     Grid.Row="1"
                                     ItemsSource="{Binding SelectedJob.Files}"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     SelectionMode="Single"
                                     EnableRowVirtualization="True"
                                     EnableColumnVirtualization="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <!-- Status Icon -->
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                                          FontSize="16"
                                                          Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- File Icon -->
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsFolder, Converter={StaticResource StatusToIconConverter}}"
                                                          FontSize="16"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{StaticResource WarningBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- File Name -->
                                    <DataGridTextColumn Header="File Name"
                                                       Binding="{Binding FileName}"
                                                       Width="*"/>

                                    <!-- Source Hash -->
                                    <DataGridTextColumn Header="Source"
                                                       Binding="{Binding SourceHash}"
                                                       Width="100"/>

                                    <!-- Target Hash -->
                                    <DataGridTextColumn Header="Target"
                                                       Binding="{Binding TargetHash}"
                                                       Width="100"/>

                                    <!-- Size -->
                                    <DataGridTextColumn Header="Size"
                                                       Binding="{Binding FormattedSize}"
                                                       SortMemberPath="FileSize"
                                                       Width="100"/>

                                    <!-- Attributes -->
                                    <DataGridTextColumn Header="Attr"
                                                       Binding="{Binding Status}"
                                                       Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Target Tab -->
                    <TabItem Header="Target">
                        <ScrollViewer>
                            <StackPanel Margin="16">
                                <TextBlock Text="Target Configuration"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="App ID:"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedJob.AppId}"
                                        Margin="0,0,0,16"/>

                                <TextBlock Text="Depot ID:"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedJob.DepotId}"
                                        Margin="0,0,0,16"/>

                                <TextBlock Text="Branch:"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedJob.Branch}"
                                        Margin="0,0,0,16"/>

                                <TextBlock Text="Target Directory:"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedJob.TargetPath}"
                                        Margin="0,0,0,16"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Options Tab -->
                    <TabItem Header="Options">
                        <ScrollViewer>
                            <StackPanel Margin="16">
                                <TextBlock Text="Download Options"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,16"/>

                                <CheckBox Content="Verify files after download"
                                         IsChecked="{Binding SelectedJob.VerifyFiles}"
                                         Margin="0,0,0,12"/>

                                <CheckBox Content="Download all platforms"
                                         Margin="0,0,0,12"/>

                                <CheckBox Content="Download all architectures"
                                         Margin="0,0,0,12"/>

                                <CheckBox Content="Download all languages"
                                         Margin="0,0,0,12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Status Tab -->
                    <TabItem Header="Status">
                        <ScrollViewer>
                            <StackPanel Margin="16">
                                <TextBlock Text="Download Status"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJob.Status}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Progress:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8">
                                        <Run Text="{Binding SelectedJob.Progress, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                        <Run Text="%"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Files:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8">
                                        <Run Text="{Binding SelectedJob.ProcessedFiles, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding SelectedJob.TotalFiles, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Downloaded:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                              Text="{Binding SelectedJob.DownloadedSize, Converter={StaticResource BytesToStringConverter}}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Size:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                              Text="{Binding SelectedJob.TotalSize, Converter={StaticResource BytesToStringConverter}}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Speed:"
                                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                              Text="{Binding SelectedJob.Speed, Converter={StaticResource SpeedToStringConverter}}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Log Tab -->
                    <TabItem Header="Log">
                        <Grid>
                            <TextBox x:Name="LogTextBox"
                                    Text="{Binding LogText}"
                                    IsReadOnly="True"
                                    VerticalScrollBarVisibility="Auto"
                                    TextWrapping="Wrap"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Padding="8"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Bottom Control Bar -->
            <Border Grid.Row="4"
                   Background="{StaticResource SecondaryBackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Start" Width="80" Margin="0,0,8,0"
                               Command="{Binding StartDownloadCommand}"/>
                        <Button Content="Resume" Width="80" Margin="0,0,8,0"
                               Command="{Binding ResumeJobCommand}"/>
                        <Button Content="Pause" Width="80" Margin="0,0,8,0"
                               Command="{Binding PauseJobCommand}"/>
                        <Button Content="Skip" Width="80" Margin="0,0,8,0"
                               Command="{Binding SkipFileCommand}"/>
                        <Button Content="Stop" Width="80" Margin="0,0,8,0"
                               Command="{Binding StopJobCommand}"/>
                    </StackPanel>

                    <!-- Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="On finish: keep app open"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <CheckBox Content="Unattended"
                                 IsChecked="{Binding UnattendedMode}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"/>
                        <CheckBox Content="Verify"
                                 IsChecked="{Binding VerifyMode}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
